{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodeployer.local/contract/run_result.schema.json",
  "title": "RunResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "short_id",
    "job_id",
    "env_profile",
    "trigger",
    "status",
    "plan_id",
    "project_version",
    "log_path",
    "started",
    "steps"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "short_id": { "type": "string", "minLength": 1, "maxLength": 16 },
    "job_id": { "type": "string" },
    "env_profile": { "type": "string" },
    "trigger": { "type": "string", "enum": ["manual", "scheduled", "gui"] },
    "actor": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["running", "succeeded", "failed", "timeout", "cancelled", "skipped"]
    },
    "skip_reason": { "type": ["string", "null"] },
    "exit_code": { "type": ["integer", "null"] },
    "plan_id": { "type": "string" },
    "project_version": { "type": "string" },
    "log_path": { "type": "string" },
    "started": {
      "type": "string",
      "description": "Canonical local+offset timestamp",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"
    },
    "ended": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"
    },
    "error_summary": { "type": ["string", "null"] },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "name", "command"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "name": { "type": "string" },
          "command": { "type": "string" },
          "output_code_page": { "type": "string" },
          "detach": { "type": "boolean" },
          "exit_code": { "type": ["integer", "null"] },
          "duration_ms": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
