{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autodeployer.local/contract/machine.schema.json",
  "title": "MachineYaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["machine_name", "allowed_envs", "default_env", "default_output_code_page"],
  "properties": {
    "machine_name": { "type": "string", "minLength": 1 },
    "allowed_envs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "default_env": { "type": "string", "minLength": 1 },
    "default_output_code_page": { "type": "string", "minLength": 1 },
    "env_file_encoding": { "type": "string" },
    "log_retention_days": { "type": "integer", "minimum": 1 },
    "allow_example_env": { "type": "boolean" },
    "promote_wait_seconds_manual": { "type": "integer", "minimum": 0 },
    "promote_wait_seconds_scheduled": { "type": "integer", "minimum": 0 },
    "secret_min_mask_length": { "type": "integer", "minimum": 1 },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_failure": { "type": "boolean" },
        "on_skipped": { "type": "boolean" },
        "webhook_url": { "type": "string" },
        "smtp": { "type": "object" }
      }
    }
  }
}
