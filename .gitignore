# Machine-local data: never commit (secrets, logs, history, schedules)
data/*
!data/.gitkeep

# Build output
app/*
!app/.gitkeep
*.exe
/bin/

# Real env files (only *.example templates are committed)
.env
.env.*
!.env.*.example

# Contract validator venv (local)
.venv-contract/

# Contract validator venv (local)
.venv-contract/

# Editor / OS
.idea/
.vscode/
.DS_Store
